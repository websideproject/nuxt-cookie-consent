{
  "name": "nuxt-cookie-consent-monorepo",
  "private": true,
  "type": "module",
  "description": "GDPR-compliant, intelligent, and customizable cookie consent module for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websideproject/nuxt-cookie-consent.git"
  },
  "author": "Benjamin Gervan",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "turbo run dev --filter=nuxt-cookie-consent-playground",
    "dev:prepare": "turbo run dev:prepare",
    "dev:docs": "turbo run dev --filter=nuxt-cookie-consent-docs",
    "docs": "turbo run dev --filter=nuxt-cookie-consent-docs",
    "build": "turbo run build",
    "build:module": "turbo run build --filter=@websideproject/nuxt-cookie-consent",
    "build:docs": "turbo run build --filter=nuxt-cookie-consent-docs",
    "build:packages": "turbo run build --filter=./packages/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "automd": "automd --config .github/automd.json",
    "version": "scripts/update-version.sh"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.15.2",
    "@types/node": "^22.0.0",
    "automd": "^0.4.0",
    "eslint": "^10.3.0",
    "turbo": "^2.9.9",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}
