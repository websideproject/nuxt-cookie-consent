{
  "name": "@websideproject/nuxt-cookie-consent",
  "version": "0.1.0",
  "description": "GDPR cookie and cookieless-tracking consent for Nuxt 4: banner, floating button, preferences modal, consent-gated scripts and cookies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websideproject/nuxt-cookie-consent.git",
    "directory": "packages/cookie-consent"
  },
  "homepage": "https://websideproject.com/docs/nuxt-cookie-consent",
  "bugs": {
    "url": "https://github.com/websideproject/nuxt-cookie-consent/issues"
  },
  "author": {
    "name": "Benjamin Gervan",
    "url": "https://github.com/bgervan"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "cookie-consent",
    "gdpr",
    "privacy",
    "consent",
    "cookies",
    "nuxt-scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "release": "bun run lint && bun run test && bun run build && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NO_COLOR=1 vitest run --passWithNoTests",
    "test:watch": "NO_COLOR=1 vitest watch",
    "typecheck": "vue-tsc --noEmit",
    "test:coverage": "NO_COLOR=1 vitest run --coverage"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.0",
    "defu": "^6.1.4"
  },
  "peerDependencies": {
    "@nuxt/scripts": "^1.0.0",
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/scripts": "^1.3.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^4",
    "@vue/test-utils": "^2.4.6",
    "changelogen": "^0.6.2",
    "happy-dom": "^15.11.7",
    "nuxt": "^4.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.13",
    "vue-tsc": "^3.2.8"
  }
}
